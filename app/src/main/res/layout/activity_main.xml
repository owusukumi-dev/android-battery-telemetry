<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Segmented control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/seg_bg"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabOverview"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/seg_selected"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:text="Overview"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabDiagnostics"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Diagnostics"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1544dp"
        android:layout_weight="1">

        <include layout="@layout/page_overview" />

        <include
            layout="@layout/page_diagnostics"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>